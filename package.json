{
  "name": "erc-together-uploader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:worker": "wrangler dev --remote --port 8787",
    "dev": "concurrently -k -n ui,worker -c cyan,magenta \"npm run dev:ui\" \"npm run dev:worker\"",
    "build": "tsc -b && vite build",
    "preview": "wrangler dev --remote",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:status": "wrangler d1 migrations list DB --remote",
    "db:migrate:remote:status": "wrangler d1 migrations list DB --remote",
    "seed:documents": "node scripts/generate_seed_documents.js",
    "sharepoint:tree": "node scripts/fetch-sharepoint-tree.js"
  },
  "dependencies": {
    "axios": "^1.2.1",
    "feather-icons": "^4.29.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "react": "^18.2.0",
    "react-content-loader": "^6.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-icons": "^4.7.1",
    "react-router-dom": "^6.5.0",
    "react-select": "^5.7.0",
    "react-toastify": "^9.1.1",
    "recharts": "^2.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/feather-icons": "^4.29.1",
    "@types/file-saver": "^2.0.5",
    "@types/lodash": "^4.14.191",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "autoprefixer": "^10.4.13",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.20",
    "sass": "^1.57.0",
    "tailwindcss": "^3.2.4",
    "typescript": "^4.9.3",
    "vite": "^4.0.0",
    "vite-plugin-mkcert": "^1.10.1",
    "wrangler": "^4.158.0"
  }
}
