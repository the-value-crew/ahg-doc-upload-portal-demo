/**
 * Cloudflare Workers Static Assets & API Configuration
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahg-doc-upload-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ahg-doc-upload-portal",
      "database_id": "d2acc83b-3fd9-4400-ad20-22f39a00f12a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS_BUCKET",
      "bucket_name": "ahg-doc-upload-portal-documents"
    }
  ],
  "vars": {
    "ALLOWED_PARENT_ORIGINS": "http://localhost:3000 http://localhost:5173 https://app.example.com",
    "MAX_UPLOAD_BYTES": "26214400"
  },
  "observability": {
    "enabled": true
  }
}

